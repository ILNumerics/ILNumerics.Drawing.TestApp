<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12</LangVersion>
    <StartupObject>ILNumerics.VisualDrawingTestApp.Windows.App</StartupObject>
    <Configurations>Debug;Release;ProjectReferences_DEBUG;ProjectReferences_Release;Accelerator_Debug_FastBuild;Packages_Debug;Packages_Release</Configurations>
  </PropertyGroup>

  <!-- UseWindowsForms is required for WindowsFormsHost (WindowsFormsIntegration). Its implicit global usings
       would make WPF types ambiguous (Application, Panel, Label, Color, ...): WinForms types are referenced explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework)=='net461'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <ItemGroup Condition="!$(Configuration.StartsWith('ProjectReferences'))">
    <PackageReference Include="ILNumerics.Computing" Version="7.4.83" />
    <PackageReference Include="ILNumerics.Drawing.Platforms" Version="7.4.83" />
    <PackageReference Include="ILNumerics.Toolboxes.Drawing2" Version="7.4.83" />
    <PackageReference Include="ILNumerics.Toolboxes.Interpolation" Version="7.4.83" />
    <PackageReference Include="ILNumerics.Toolboxes.Optimization" Version="7.4.83" />
    <PackageReference Include="ILNumerics.Toolboxes.Statistics" Version="7.4.83" />
  </ItemGroup>

  <ItemGroup Condition="$(Configuration.StartsWith('ProjectReferences'))">
    <ProjectReference Include="..\..\..\ILNumerics.Drawing\src\ILNumerics.Drawing.csproj" />
    <ProjectReference Include="..\..\..\ILNumerics.Core\src\ILNumerics.Core.csproj" />
    <ProjectReference Include="..\..\src\ILNumerics.Drawing.Platforms.csproj" />
    <ProjectReference Include="..\..\..\ILNumerics.Toolboxes\ILNumerics.Toolboxes.Drawing2\src\ILNumerics.Toolboxes.Drawing2.csproj" />
    <ProjectReference Include="..\..\..\ILNumerics.Toolboxes\ILNumerics.Toolboxes.Interpolation\src\ILNumerics.Toolboxes.Interpolation.csproj" />
    <ProjectReference Include="..\..\..\ILNumerics.Toolboxes\ILNumerics.Toolboxes.Statistics\src\ILNumerics.Toolboxes.Statistics.csproj" />
  </ItemGroup>

</Project>

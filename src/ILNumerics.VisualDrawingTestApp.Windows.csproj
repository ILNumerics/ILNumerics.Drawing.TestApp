<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12</LangVersion>
    <StartupObject>ILNumerics.VisualDrawingTestApp.Windows.App</StartupObject>
    <Configurations>Debug;Release;ProjectReferences_DEBUG;ProjectReferences_Release;Accelerator_Debug_FastBuild;Packages_Debug;Packages_Release</Configurations>
  </PropertyGroup>

  <!-- UseWindowsForms is required for WindowsFormsHost (WindowsFormsIntegration). Its implicit global usings
       would make WPF types ambiguous (Application, Panel, Label, Color, ...): WinForms types are referenced explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework)=='net461'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <!--
    Source of the ILNumerics modules:
    * NuGet packages (default).
    * Local ILNumerics module projects (ProjectReference), when the root folder of a local modules tree is given
      (the folder containing ILNumerics.Core, ILNumerics.Drawing, ILNumerics.Drawing.Platforms, ILNumerics.Toolboxes, ...):
          dotnet build -c Debug /p:ModulesBasePath='C:\path_to\Version6'
          dotnet run   -c Debug /p:ModulesBasePath='C:\path_to\Version6'
      'ProjectReferences*' configurations use local module projects, too. Without ModulesBasePath they expect the
      app to be located inside the modules tree (ModulesBasePath = ..\..\..\, as before).
    * /p:UseLocalModules=true|false overrides the decision.
  -->
  <PropertyGroup>
    <_ILNModulesBasePathGiven Condition="'$(ModulesBasePath)' != ''">true</_ILNModulesBasePathGiven>
    <!-- ModulesBasePath is a global (read-only) property when given on the command line: normalize into _ILNModulesRoot.
         Remove quotes possibly passed literally (/p:ModulesBasePath='C:\...'). -->
    <_ILNModulesRoot>$(ModulesBasePath.Replace(`'`, ``).Replace(`"`, ``).Trim())</_ILNModulesRoot>
    <_ILNModulesRoot Condition="'$(_ILNModulesRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\</_ILNModulesRoot>
    <_ILNModulesRoot>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(_ILNModulesRoot)'))'))</_ILNModulesRoot>

    <UseLocalModules Condition="'$(UseLocalModules)' == '' And '$(_ILNModulesBasePathGiven)' == 'true'">true</UseLocalModules>
    <UseLocalModules Condition="'$(UseLocalModules)' == '' And $(Configuration.StartsWith('ProjectReferences'))">true</UseLocalModules>
    <UseLocalModules Condition="'$(UseLocalModules)' == ''">false</UseLocalModules>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalModules)' != 'true'">
    <PackageReference Include="ILNumerics.Computing" Version="7.4.83" />
    <PackageReference Include="ILNumerics.Drawing.Platforms" Version="7.4.83" />
    <PackageReference Include="ILNumerics.Toolboxes.Drawing2" Version="7.4.83" />
    <PackageReference Include="ILNumerics.Toolboxes.Interpolation" Version="7.4.83" />
    <PackageReference Include="ILNumerics.Toolboxes.Optimization" Version="7.4.83" />
    <PackageReference Include="ILNumerics.Toolboxes.Statistics" Version="7.4.83" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalModules)' == 'true'">
    <ILNLocalModule Include="$(_ILNModulesRoot)ILNumerics.Core\src\ILNumerics.Core.csproj" />
    <ILNLocalModule Include="$(_ILNModulesRoot)ILNumerics.Drawing\src\ILNumerics.Drawing.csproj" />
    <ILNLocalModule Include="$(_ILNModulesRoot)ILNumerics.Drawing.Platforms\src\ILNumerics.Drawing.Platforms.csproj" />
    <ILNLocalModule Include="$(_ILNModulesRoot)ILNumerics.Toolboxes\ILNumerics.Toolboxes.Drawing2\src\ILNumerics.Toolboxes.Drawing2.csproj" />
    <ILNLocalModule Include="$(_ILNModulesRoot)ILNumerics.Toolboxes\ILNumerics.Toolboxes.Interpolation\src\ILNumerics.Toolboxes.Interpolation.csproj" />
    <ILNLocalModule Include="$(_ILNModulesRoot)ILNumerics.Toolboxes\ILNumerics.Toolboxes.Statistics\src\ILNumerics.Toolboxes.Statistics.csproj" />
    <ProjectReference Include="@(ILNLocalModule)" />
  </ItemGroup>

  <Target Name="ILNCheckLocalModules" BeforeTargets="CollectPackageReferences;ResolveProjectReferences;Build" Condition="'$(UseLocalModules)' == 'true'">
    <Error Condition="!Exists('%(ILNLocalModule.Identity)')"
           Text="ILNumerics module project not found: '%(ILNLocalModule.Identity)'. Set ModulesBasePath to the root of a local ILNumerics modules tree (the folder containing ILNumerics.Core, ILNumerics.Drawing, ...), e.g.: /p:ModulesBasePath='C:\path_to\Version6'. Current: '$(_ILNModulesRoot)'." />
    <Message Importance="high" Text="ILNumerics modules: local projects from '$(_ILNModulesRoot)'" />
  </Target>

</Project>
